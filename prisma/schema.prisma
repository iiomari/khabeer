// Enum-like columns are stored as strings; the allowed values live in
// src/lib/enums.ts and are enforced by Zod + TypeScript at every write site.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  /// EXPERT | CLIENT | ADMIN
  role         String
  /// ACTIVE | SUSPENDED
  status       String   @default("ACTIVE")
  phone        String?
  city         String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expertProfile       ExpertProfile?
  clientProfile       ClientProfile?
  clientBookings      Booking[]      @relation("ClientBookings")
  expertBookings      Booking[]      @relation("ExpertBookings")
  clientConversations Conversation[] @relation("ClientConversations")
  expertConversations Conversation[] @relation("ExpertConversations")
  messages            Message[]
  reviewsWritten      Review[]       @relation("ClientReviews")
  reviewsReceived     Review[]       @relation("ExpertReviews")
  favorites           Favorite[]     @relation("ClientFavorites")
  favoritedBy         Favorite[]     @relation("ExpertFavoritedBy")
  notifications       Notification[]
  requests            ConsultationRequest[]
  vouchers            RewardVoucher[] @relation("ExpertVouchers")

  @@index([role])
  @@index([status])
}

model ExpertProfile {
  id                   String  @id @default(cuid())
  userId               String  @unique
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline             String?
  bio                  String?
  previousTitle        String?
  previousOrganization String?
  yearsOfExperience    Int     @default(0)
  city                 String?

  /// DRAFT | PENDING | VERIFIED | REJECTED
  verificationStatus     String    @default("DRAFT")
  rejectionReason        String?
  ratingAvg              Float     @default(0)
  ratingCount            Int       @default(0)
  completedConsultations Int       @default(0)
  minPriceSar            Int?
  onboardingStep         Int       @default(1)

  /// Practising licence, required only when one of the expert's categories is
  /// regulated. NOT_REQUIRED | MISSING | PENDING | APPROVED | REJECTED
  licenseStatus          String    @default("NOT_REQUIRED")
  licenseNumber          String?
  licenseIssuer          String?
  licenseExpiry          DateTime?
  licenseDocUrl          String?
  licenseRejectionReason String?

  publishedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  experiences    Experience[]
  educations     Education[]
  certifications Certification[]
  skills         Skill[]
  categories     ExpertCategory[]
  services       ConsultingService[]
  availability   AvailabilitySlot[]

  @@index([verificationStatus])
  @@index([ratingAvg])
  @@index([yearsOfExperience])
  @@index([minPriceSar])
  @@index([city])
}

model ClientProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isCompany   Boolean  @default(false)
  companyName String?
  industry    String?
  /// السجل التجاري — collected from companies at sign-up.
  commercialRegistration String?
  crExpiry               DateTime?
  website                String?
  employeeCount          String?
  contactTitle           String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id              String        @id @default(cuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  organization    String
  position        String
  startYear       Int
  endYear         Int?
  isCurrent       Boolean       @default(false)
  description     String?
  sortOrder       Int           @default(0)

  @@index([expertProfileId])
}

model Education {
  id              String        @id @default(cuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  institution     String
  degree          String
  field           String?
  graduationYear  Int?
  sortOrder       Int           @default(0)

  @@index([expertProfileId])
}

model Certification {
  id              String        @id @default(cuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  name            String
  issuer          String
  issueYear       Int?
  credentialUrl   String?
  sortOrder       Int           @default(0)

  @@index([expertProfileId])
}

model Skill {
  id              String        @id @default(cuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  name            String

  @@index([expertProfileId])
  @@index([name])
}

model Category {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  icon        String?
  description String?
  sortOrder   Int              @default(0)
  /// Fields where Saudi regulation requires a practising licence before an
  /// expert may be booked. Set per category, not hard-coded in the UI.
  requiresLicense Boolean @default(false)
  createdAt   DateTime         @default(now())
  experts     ExpertCategory[]
  requests    ConsultationRequest[]
}

model ExpertCategory {
  expertProfileId String
  categoryId      String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([expertProfileId, categoryId])
  @@index([categoryId])
}

model ConsultingService {
  id              String        @id @default(cuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  name            String
  description     String
  durationMinutes Int
  priceSar        Int
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bookings        Booking[]

  @@index([expertProfileId])
}

model AvailabilitySlot {
  id              String        @id @default(cuid())
  expertProfileId String
  expertProfile   ExpertProfile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  dayOfWeek       Int
  startMinute     Int
  endMinute       Int

  @@index([expertProfileId])
}

model Booking {
  id              String            @id @default(cuid())
  bookingRef      String            @unique
  clientId        String
  expertId        String
  serviceId       String
  client          User              @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  expert          User              @relation("ExpertBookings", fields: [expertId], references: [id], onDelete: Cascade)
  service         ConsultingService @relation(fields: [serviceId], references: [id])
  scheduledAt     DateTime
  durationMinutes Int
  priceSar        Int
  description     String

  /// How the two sides will meet, agreed inside the conversation.
  /// GOOGLE_MEET | ZOOM | TEAMS | PHONE
  meetingProvider String?
  meetingUrl      String?
  meetingNote     String?

  /// Set when the booking came out of an AI match, so the expert can see the brief.
  requestId String?
  request   ConsultationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  /// PENDING | CONFIRMED | REJECTED | CANCELLED | COMPLETED
  status       String    @default("PENDING")
  statusReason String?
  /// When the expert accepted or rejected. Kept separately because updatedAt is
  /// rewritten by any later edit, which would silently corrupt response-time KPIs.
  respondedAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  payment      Payment?
  review       Review?
  conversation Conversation?

  @@index([clientId, status])
  @@index([expertId, status])
  @@index([scheduledAt])
  @@index([serviceId])
  @@index([requestId])
}

/// A problem written in the client's own words, plus the structured brief derived
/// from it. Kept even when the visitor never signs in, so the brief survives the
/// trip through the login screen and can be attached to the booking afterwards.
model ConsultationRequest {
  id       String  @id @default(cuid())
  clientId String?
  client   User?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  rawText  String
  /// sha256 of the normalised text — lets an identical problem reuse a fresh brief.
  textHash String

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  reframedQuestion String
  keySkills        String[]
  questionsToAsk   String[]
  suggestedMinutes Int
  budgetMinSar     Int
  budgetMaxSar     Int

  /// claude | heuristic — which engine produced this brief.
  engine String

  createdAt DateTime  @default(now())
  bookings  Booking[]

  @@index([textHash, createdAt])
  @@index([categoryId, createdAt])
  @@index([clientId, createdAt])
}

model Payment {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountSar Int

  /// MADA | APPLE_PAY | CARD
  method String
  /// PAID | REFUNDED | FAILED
  status String @default("PAID")

  transactionRef String   @unique
  provider       String   @default("mock")
  cardLast4      String?
  createdAt      DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model Conversation {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId      String
  expertId      String
  client        User      @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  expert        User      @relation("ExpertConversations", fields: [expertId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@index([clientId, lastMessageAt])
  @@index([expertId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  /// Optional attachment. Kept as a URL so the storage backend can change
  /// without touching the message model.
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  attachment     Attachment?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

/// Files shared inside a consultation. Bytes live in Postgres rather than object
/// storage so access control is the same query as the conversation itself: only
/// the two participants can read them, with no presigned URLs to leak.
model Attachment {
  id          String   @id @default(cuid())
  messageId   String   @unique
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName    String
  contentType String
  sizeBytes   Int
  data        Bytes
  createdAt   DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId  String
  expertId  String
  client    User     @relation("ClientReviews", fields: [clientId], references: [id], onDelete: Cascade)
  expert    User     @relation("ExpertReviews", fields: [expertId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([expertId, createdAt])
  @@index([clientId])
}

model Favorite {
  id        String   @id @default(cuid())
  clientId  String
  expertId  String
  client    User     @relation("ClientFavorites", fields: [clientId], references: [id], onDelete: Cascade)
  expert    User     @relation("ExpertFavoritedBy", fields: [expertId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clientId, expertId])
  @@index([expertId])
}

/// A voucher an expert has earned by completing consultations. Rows are created
/// when the milestone is crossed, never recalculated — so a reward already given
/// is not withdrawn if a booking is later refunded.
model RewardVoucher {
  id          String    @id @default(cuid())
  expertId    String
  expert      User      @relation("ExpertVouchers", fields: [expertId], references: [id], onDelete: Cascade)
  /// Matches a key in src/lib/rewards.ts
  tierKey     String
  partner     String
  valueSar    Int
  /// Shown once, then treated as used.
  code        String    @unique
  redeemedAt  DateTime?
  earnedAt    DateTime  @default(now())

  @@unique([expertId, tierKey])
  @@index([expertId, earnedAt])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// BOOKING_REQUESTED | BOOKING_ACCEPTED | BOOKING_REJECTED | BOOKING_CANCELLED |
  /// APPOINTMENT_REMINDER | NEW_MESSAGE | NEW_REVIEW | PAYMENT_SUCCESS |
  /// PROFILE_VERIFIED | PROFILE_REJECTED
  type String

  title     String
  body      String
  linkUrl   String?
  relatedId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type, relatedId])
}
